---
import { site, categorias } from '../data/site';
import { url } from '../lib/url';

const atual = Astro.url.pathname.replace(/\/$/, '');
const links = [
  ...categorias.map((c) => ({ href: url(`/${c.slug}`), texto: c.titulo })),
  { href: url('/sobre'), texto: 'Sobre' },
  { href: url('/contato'), texto: 'Contato' },
];
---

<header class="topo">
  <a class="marca" href={url('/')}>{site.nome}</a>
  <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu">
    <span></span><span></span>
    <span class="sr">Menu</span>
  </button>
  <nav id="menu" class="menu">
    {
      links.map((link) => (
        <a href={link.href} aria-current={atual === link.href ? 'page' : undefined}>
          {link.texto}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const topo = document.querySelector('.topo')!;
  const botao = topo.querySelector<HTMLButtonElement>('.menu-botao')!;

  botao.addEventListener('click', () => {
    const aberto = topo.classList.toggle('aberto');
    botao.setAttribute('aria-expanded', String(aberto));
  });

  // Fundo escurece quando a página rola
  const aoRolar = () => topo.classList.toggle('rolou', window.scrollY > 40);
  window.addEventListener('scroll', aoRolar, { passive: true });
  aoRolar();
</script>

<style>
  .topo {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--margem);
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.6), transparent);
    transition: background 0.4s, padding 0.4s;
  }

  .topo.rolou {
    background: rgb(11 10 15 / 0.85);
    backdrop-filter: blur(12px);
    padding-block: 0.9rem;
  }

  .marca {
    font-family: var(--fonte-titulo);
    font-size: 1.5rem;
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .menu {
    display: flex;
    gap: 2rem;
  }

  .menu a {
    position: relative;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--texto-suave);
    transition: color 0.3s;
  }

  .menu a:hover,
  .menu a[aria-current='page'] {
    color: var(--texto);
  }

  .menu a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.25em;
    bottom: -6px;
    height: 1px;
    background: var(--destaque);
  }

  .menu-botao {
    display: none;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 760px) {
    .menu-botao {
      display: grid;
      gap: 6px;
      padding: 10px 4px;
      background: none;
      border: 0;
      cursor: pointer;
      z-index: 2;
    }

    .menu-botao span:not(.sr) {
      display: block;
      width: 26px;
      height: 1px;
      background: var(--texto);
      transition: transform 0.3s;
    }

    .aberto .menu-botao span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .aberto .menu-botao span:nth-child(2) {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    .menu {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2.2rem;
      background: var(--fundo);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s, visibility 0.3s;
    }

    .aberto .menu {
      opacity: 1;
      visibility: visible;
    }

    .menu a {
      font-family: var(--fonte-titulo);
      font-size: 2.2rem;
      font-style: italic;
      letter-spacing: 0;
      text-transform: none;
    }
  }
</style>
