---
// Slider principal (inspirado no "T.RICKS Slider"): arrasta com o mouse ou o dedo, roda em loop
// e tem o efeito de "tela curva": cada foto gira em 3D conforme a distância do centro, então as
// pontas ficam mais altas que o meio, sem cortar nada da foto. Usa a biblioteca Splide.
import { Image } from 'astro:assets';
import type { Foto } from '../lib/fotos';
import { categorias } from '../data/site';
import { url } from '../lib/url';

interface Props {
  fotos: Foto[];
}

const { fotos } = Astro.props;
const tituloDa = (slug: string) => categorias.find((c) => c.slug === slug)?.titulo ?? slug;
const doisDigitos = (n: number) => String(n).padStart(2, '0');
const primeira = fotos[0];
---

<section class="destaques" aria-label="Fotos em destaque">
  <div class="curva">
    <div class="splide" data-cursor="ARRASTE">
      <div class="splide__track">
        <ul class="splide__list">
          {
            fotos.map((foto, i) => (
              <li
                class="splide__slide"
                data-titulo={foto.alt}
                data-categoria={tituloDa(foto.categoria)}
              >
                <a class="slide" href={url(`/${foto.categoria}`)} draggable="false">
                  <Image
                    src={foto.src}
                    alt={foto.alt}
                    widths={[500, 800, 1200, 1600]}
                    sizes="(max-width: 767px) 80vw, 45vw"
                    format="webp"
                    quality={80}
                    loading={i < 4 ? 'eager' : 'lazy'}
                    draggable="false"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="rodape-slider container">
    <p class="legenda" aria-live="polite">
      <span class="legenda-num">{doisDigitos(1)}</span>
      <span class="legenda-titulo">{primeira?.alt}</span>
      <span class="legenda-categoria">{primeira && tituloDa(primeira.categoria)}</span>
    </p>

    <div class="controles">
      <button class="controle anterior" type="button" aria-label="Foto anterior">
        <span class="controle-fundo"></span><span class="controle-seta">←</span>
      </button>
      <span class="contador"><b class="contador-atual">01</b> / {doisDigitos(fotos.length)}</span>
      <button class="controle proxima" type="button" aria-label="Próxima foto">
        <span class="controle-fundo"></span><span class="controle-seta">→</span>
      </button>
    </div>
  </div>
</section>

<script>
  import Splide from '@splidejs/splide';
  import '@splidejs/splide/css/core';

  const raiz = document.querySelector<HTMLElement>('.destaques .splide');
  if (raiz) {
    const slider = new Splide(raiz, {
      type: 'loop',
      autoWidth: true, // cada foto com a largura do seu formato original
      perMove: 1,
      focus: 'center',
      gap: '1.4vw',
      arrows: false,
      pagination: false,
      speed: 900,
      easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
      dragMinThreshold: { mouse: 8, touch: 12 },
      breakpoints: {
        767: { gap: '3vw' },
      },
    }).mount();

    // Tela curva: gira cada foto em 3D de acordo com a distância até o centro da tela.
    // Fotos da esquerda viram a borda esquerda para a frente (e vice-versa), como um cinema curvo.
    const GIRO = 42; // graus na borda da tela. Aumente para curvar mais
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const slides = [...raiz.querySelectorAll<HTMLElement>('.splide__slide')];
    let visivel = true;
    new IntersectionObserver(([e]) => (visivel = e.isIntersecting)).observe(raiz);

    function curvar() {
      if (visivel) {
        const meio = innerWidth / 2;
        for (const slide of slides) {
          const r = slide.getBoundingClientRect();
          if (r.right < -200 || r.left > innerWidth + 200) continue;
          const distancia = (r.left + r.width / 2 - meio) / meio; // -1 (esquerda) a 1 (direita)
          const d = Math.max(-1.6, Math.min(1.6, distancia));
          slide.style.transform = `perspective(800px) rotateY(${-d * GIRO}deg) scale(${1 + Math.abs(d) * 0.08})`;
        }
      }
      if (!semMovimento) requestAnimationFrame(curvar);
    }
    curvar();
    slider.on('moved resized', curvar);

    const secao = raiz.closest('.destaques')!;
    const atual = secao.querySelector('.contador-atual')!;
    const legenda = secao.querySelector<HTMLElement>('.legenda')!;
    const num = legenda.querySelector('.legenda-num')!;
    const titulo = legenda.querySelector('.legenda-titulo')!;
    const categoria = legenda.querySelector('.legenda-categoria')!;

    // Troca a legenda com uma pequena animação quando a foto do centro muda
    slider.on('move', (indice) => {
      const slide = slider.Components.Slides.getAt(indice)?.slide;
      const n = String(indice + 1).padStart(2, '0');
      atual.textContent = n;
      legenda.classList.add('trocando');
      setTimeout(() => {
        num.textContent = n;
        titulo.textContent = slide?.dataset.titulo ?? '';
        categoria.textContent = slide?.dataset.categoria ?? '';
        legenda.classList.remove('trocando');
      }, 250);
    });

    secao.querySelector('.anterior')!.addEventListener('click', () => slider.go('<'));
    secao.querySelector('.proxima')!.addEventListener('click', () => slider.go('>'));
  }
</script>

<style>
  .destaques {
    padding-top: clamp(64px, 12vh, 130px);
    overflow: hidden;
  }

  /* ---------- Tamanho: a foto inteira sempre cabe na tela ---------- */
  .curva {
    --altura: min(64vh, 640px); /* altura das fotos do slider */
    padding-block: 2rem; /* espaço para as pontas "crescerem" com o giro 3D */
  }

  .splide__slide {
    will-change: transform;
  }

  .splide {
    cursor: grab;
  }

  .splide:active {
    cursor: grabbing;
  }

  .slide {
    display: block;
    height: var(--altura);
    overflow: hidden;
    background: var(--fundo-2);
    user-select: none;
  }

  .slide img {
    display: block;
    width: auto;
    height: 100%;
    max-width: 88vw; /* foto deitada no celular não passa da tela */
    object-fit: cover;
    pointer-events: none;
    filter: brightness(0.6) saturate(0.8);
    transform: scale(1.08);
    transition:
      filter 0.9s,
      transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .splide__slide.is-active .slide img {
    filter: none;
    transform: scale(1);
  }

  /* ---------- Legenda e controles ---------- */
  .rodape-slider {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: 1.5rem;
  }

  .legenda {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0;
    transition:
      opacity 0.25s,
      translate 0.25s;
  }

  .legenda.trocando {
    opacity: 0;
    translate: 0 8px;
  }

  .legenda-num {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--destaque);
  }

  .legenda-titulo {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    text-transform: lowercase;
  }

  .legenda-categoria {
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  /* Setas redondas que "enchem" de roxo no hover */
  .controles {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .controle {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    padding: 0;
    border: 1px solid rgb(236 233 242 / 0.35);
    border-radius: 50%;
    background: none;
    color: var(--texto);
    font-size: 1.1rem;
    overflow: hidden;
    cursor: pointer;
  }

  .controle-fundo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--destaque-forte);
    transform: scale(0);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .controle:hover .controle-fundo {
      transform: scale(1);
    }
  }

  .controle-seta {
    position: relative;
    transition: translate 0.3s;
  }

  .anterior:hover .controle-seta {
    translate: -3px 0;
  }

  .proxima:hover .controle-seta {
    translate: 3px 0;
  }

  .contador {
    min-width: 5.5rem;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--texto-suave);
  }

  .contador b {
    font-weight: 400;
    color: var(--texto);
  }

  @media (max-width: 767px) {
    .curva {
      --altura: min(58vh, 520px);
    }

    .rodape-slider {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide img,
    .legenda {
      transition: none;
    }
  }
</style>
